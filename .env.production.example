# VPS Production Environment Configuration for Clearlist Backend
# Copy this file to /opt/clearlist/.env on your VPS

# Domain & SSL (for Caddy)
API_DOMAIN=api.yourdomain.com
ACME_EMAIL=admin@yourdomain.com

# CORS: Set to your Vercel frontend URL(s)
CORS_ORIGINS=https://yourdomain.com,https://your-app.vercel.app

# Email Verification Engine (Enabled on VPS because SMTP port 25 is unblocked)
SMTP_ENABLED=true
CATCH_ALL_ENABLED=true
DNS_TIMEOUT_SECONDS=5
SMTP_TIMEOUT_SECONDS=8
CACHE_TTL_SECONDS=3600
MAX_BATCH_SIZE=500
GLOBAL_CONCURRENCY=30
PER_DOMAIN_CONCURRENCY=3

# Admin Secret (Required, must be at least 16 characters)
ADMIN_SECRET_KEY=change-this-to-a-secure-random-32-char-key

# Single-use upload token secret
UPLOAD_TOKEN_SECRET=change-this-to-another-secure-secret-key

# Optional Backblaze B2 Storage
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_BUCKET=your-b2-bucket
B2_KEY_ID=
B2_APPLICATION_KEY=

# Optional Firebase / Firestore Metadata Storage
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_ID=(default)
CONTACT_RATE_LIMIT_PER_HOUR=5
